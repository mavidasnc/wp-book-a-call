includes:
    - vendor/szepeviktor/phpstan-wordpress/extension.neon

parameters:
    level: 6
    ignoreErrors:
        # plugin-update-checker restituisce tipi generici: i metodi esistono a runtime.
        - '#Call to an undefined method .+::(getUpdate|checkForUpdates|getUpdateState|enableReleaseAssets)\(\)#'
    paths:
        - src
        - wp-book-a-call.php
        - uninstall.php
    # Costanti definite nel file principale del plugin.
    dynamicConstantNames:
        - WPBAC_DEBUG
    scanFiles:
        - phpstan-constants.php
    bootstrapFiles:
        - vendor/php-stubs/wordpress-stubs/wordpress-stubs.php
